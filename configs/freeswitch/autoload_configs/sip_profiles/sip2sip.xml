<include>
  <!-- Free SIP2Sip Service -->
  <gateway name="sip2sip_trunk">
    <param name="username" value="your_sip2sip_username"/>
    <param name="password" value="your_sip2sip_password"/>
    <param name="realm" value="sip2sip.info"/>
    <param name="from-user" value="your_sip2sip_username"/>
    <param name="from-domain" value="sip2sip.info"/>
    <param name="proxy" value="sip.sip2sip.info"/>
    <param name="register" value="true"/>
    <param name="register-transport" value="udp"/>
    <param name="expire-seconds" value="3600"/>
    <param name="retry-seconds" value="30"/>
    <param name="caller-id-in-from" value="true"/>
    <param name="extension-in-contact" value="true"/>
    <param name="context" value="default"/>
    <param name="dialplan" value="XML"/>
  </gateway>
</include>
